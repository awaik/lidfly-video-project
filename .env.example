# Server-side secrets. Never commit real values.
EVOLINK_API_KEY=
OPENROUTER_API_KEY=
TTS_KOMEND_AUTH_TOKEN=

# Optional endpoint overrides for local contract testing only.
# EVOLINK_API_BASE_URL=https://api.evolink.ai
# EVOLINK_FILES_BASE_URL=https://files-api.evolink.ai

# Komend TTS and speech-recognition routes. Set explicitly when using Komend commands.
# KOMEND_TTS_ENDPOINT=https://tts.example.com/api/synthesize
# KOMEND_ASR_ENDPOINT=https://tts.example.com/api/recognize

# OpenChatCut (interactive editing route). The checkout defaults to ../OpenChatCut next to
# this repository; `node src/cli.mjs openchatcut status` reports what it found.
# OPENCHATCUT_DIR=../OpenChatCut
# Pin the MCP bearer token instead of reading the one OpenChatCut mints into its dev profile.
# The same value must reach the editor (openchatcut start passes it through) and the MCP client.
# OPENCHATCUT_MCP_TOKEN=
# Node 24 binary for the editor when it is not the newest nvm 24.x.
# OPENCHATCUT_NODE=
